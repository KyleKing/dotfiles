    "defaultMode": "auto",
    "deny": ["Read(.\/dev.secret.local.env)"]
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen",
  "workflowKeywordTriggerEnabled": false,
  "worktree": {
    "baseRef": "fresh"
  }
