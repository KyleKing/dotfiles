{
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "WebFetch(domain:*)",
      "WebSearch"
    ],
    "defaultMode": "delegate"
  },
  "model": "sonnet",
  "enabledPlugins": {
    "pr-review-toolkit@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "promptSuggestionEnabled": false
}
