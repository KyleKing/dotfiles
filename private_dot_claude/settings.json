{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "autoUpdatesChannel": "latest",
  "editorMode": "vim",
  "effortLevel": "medium",
  "enabledPlugins": {},
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "extraKnownMarketplaces": {},
  "fileCheckpointingEnabled": false,
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\/Users\/kyleking\/.seam\/hooks\/seam-claude-code.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\/Users\/kyleking\/.seam\/hooks\/seam-claude-code.sh",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\/Users\/kyleking\/.seam\/hooks\/seam-claude-code.sh",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\/Users\/kyleking\/.seam\/hooks\/seam-claude-code.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "sonnet",
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__incident_io__*",
      "Skill(incident)"
