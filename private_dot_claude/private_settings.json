{
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Bash(uv sync:*)",
      "Bash(uv lock:*)",
      "Bash(sentry-cli releases list:*)",
      "Bash(aws sts get-caller-identity)"
    ],
    "soft_deny": [
      "$defaults",
      "Bash(aws secretsmanager put-secret-value:*)",
      "Bash(aws lambda delete-function:*)"
    ]
  },
  "autoUpdatesChannel": "latest",
  "deniedMcpServers": [
    {
      "serverUrl": "https://mcp.incident.io/*"
    }
  ],
  "editorMode": "vim",
  "effortLevel": "medium",
  "enabledPlugins": {
    "hyperskills@hyperb1iss": true,
    "impeccable@impeccable": true,
    "incident.io@anthropic-plugin-directory": true,
    "slack@claude-plugins-official": true
  },
  "env": {
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "USE_BUILTIN_RIPGREP": "0"
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    },
    "hyperb1iss": {
      "source": {
        "repo": "hyperb1iss/hyperskills",
        "source": "github"
      }
    },
    "impeccable": {
      "source": {
        "repo": "pbakaus/impeccable",
        "source": "github"
      }
    }
  },
  "fileCheckpointingEnabled": false,
  "inputNeededNotifEnabled": true,
  "model": "sonnet",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "low"
    },
    "claude-opus-5-5": {
      "effortLevel": "low"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "WebFetch(domain:*)",
      "WebSearch",
      "mcp__incident_io__*",
      "Skill(incident)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Read(./dev.secret.local.env)"
    ]
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "skipDangerousModePermissionPrompt": true,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true,
  "workflowKeywordTriggerEnabled": false
}
