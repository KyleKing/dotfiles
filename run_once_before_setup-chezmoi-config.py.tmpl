#!/usr/bin/env python3
"""Interactive chezmoi configuration setup with upgrade support."""

import platform
import subprocess
from pathlib import Path

try:
    import tomllib
except ModuleNotFoundError:
    import tomli as tomllib

CONFIG_DIR = Path.home() / ".config/chezmoi"
CONFIG_FILE = CONFIG_DIR / "chezmoi.toml"

# Detect system defaults
homebrew_prefix = "/usr/local" if platform.machine() == "x86_64" else "{{ .homebrew_prefix }}"
try:
    computer_name = subprocess.run(
        ["scutil", "--get", "ComputerName"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
except (subprocess.CalledProcessError, FileNotFoundError):
    computer_name = platform.node()

# Define required fields with defaults
FIELDS = [
    ("computer_name", computer_name),
    ("email", "placeholder"),
    ("github_ssh_key_name", "id_ed25519_github_2026"),
    ("homebrew_prefix", homebrew_prefix),
    ("github.username", "placeholder"),
    ("onepassword.domain", "placeholder"),
    ("obsidian.vault_name", "placeholder"),
]

# Load existing config or start fresh
if CONFIG_FILE.exists():
    config = tomllib.loads(CONFIG_FILE.read_text())
    is_new = False
else:
    config = {"data": {}, "edit": {"command": "nvim"}}
    is_new = True
    print("Setting up chezmoi configuration...\n")

# Prompt for missing fields
missing_any = False
for field_path, default in FIELDS:
    parts = field_path.split(".")
    section = config.setdefault("data", {})
    for part in parts[:-1]:
        section = section.setdefault(part, {})

    if parts[-1] not in section:
        missing_any = True
        value = input(f"{field_path} [{default}]: ").strip()
        section[parts[-1]] = value if value else default

# Write config if changes were made
if missing_any or is_new:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)

    lines = ["[data]"]
    for k, v in config["data"].items():
        if not isinstance(v, dict):
            lines.append(f'{k} = "{v}"')
    lines.append("")

    for subsection in ["github", "aws", "onepassword", "obsidian"]:
        if subsection in config["data"] and isinstance(config["data"][subsection], dict):
            lines.append(f"[data.{subsection}]")
            for k, v in config["data"][subsection].items():
                lines.append(f'{k} = "{v}"')
            lines.append("")

    lines.append("[edit]")
    for k, v in config.get("edit", {}).items():
        lines.append(f'{k} = "{v}"')

    CONFIG_FILE.write_text("\n".join(lines))
    print(f"\nConfiguration {'updated' if not is_new else 'created'} at {CONFIG_FILE}")
