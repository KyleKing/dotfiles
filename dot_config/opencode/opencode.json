{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "browsermcp": {
      "type": "local",
      "enabled": true,
      "command": ["npx", "-y", "@browsermcp/mcp"]
    },
    "dash-api": {
      "type": "local",
      "enabled": true,
      "command": [
        "uvx",
        "--from",
        "\"git+https://github.com/Kapeli/dash-mcp-server.git\"",
        "dash-mcp-server"
      ]
    },
    "sequential-thinking": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ]
    }
  }
}
