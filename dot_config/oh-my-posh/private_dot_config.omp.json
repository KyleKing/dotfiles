{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "p:white",
          "properties": {
            "style": "folder"
          },
          "template": "{{ .Parent }}<p:blue>{{ .Path }}</> ",
          "type": "path"
        },
        {
          "foreground": "p:blue",
          "foreground_templates": [
            "{{ if .Working.Changed }}p:yellow{{ end }}"
          ],
          "properties": {
            "fetch_ahead_counter": true,
            "fetch_status": true
          },
          "style": "plain",
          "template": "\uf1fa{{ if .ClosestBookmarks }}{{ .ClosestBookmarks }}{{ else }}{{ .ChangeID }}{{ end }}{{ if .Working.Changed }} \uf044{{ .Working.String }}{{ end }}",
          "type": "jujutsu"
        },
        {
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if .Segments.Contains \"Jujutsu\" }}{{ if .Segments.Jujutsu.Working.Changed }}p:yellow{{ else }}p:blue{{ end }}{{ end }}",
            "{{ if .Segments.Contains \"Git\" }}{{ if or .Segments.Git.Staging.Changed .Segments.Git.Working.Changed }}p:yellow{{ else }}{{ if and (gt .Segments.Git.Ahead 0) (gt .Segments.Git.Behind 0) }}p:red{{ else }}{{ if gt .Segments.Git.Ahead 0 }}p:orange{{ else }}{{ if gt .Segments.Git.Behind 0 }}p:grey{{ end }}{{ end }}{{ end }}{{ end }}{{ end }}"
          ],
          "style": "plain",
          "template": "{{ if .Env.GH_PR_NUMBER }}#{{ .Env.GH_PR_NUMBER }} {{ end }}",
          "type": "text"
        },
        {
          "foreground": "p:green",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}p:orange{{ end }}",
            "{{ if gt .Behind 0 }}p:grey{{ end }}"
          ],
          "properties": {
            "branch_max_length": 15,
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "github_icon": "\ue5fd"
          },
          "style": "plain",
          "template": "{{ if not (.Segments.Contains \"Jujutsu\") }}{{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }}{{ .BranchStatus }}{{ if or .Staging.Changed .Working.Changed }} \uf044{{ .Staging.String }}{{ .Working.String }}{{ end }}{{ end }}",
          "type": "git"
        },
        {
          "foreground": "p:blue",
          "foreground_templates": [
            "{{ if gt .Code 0 }}p:red{{ end }}"
          ],
          "properties": {
            "always_enabled": true
          },
          "style": "plain",
          "template": " {{ if gt .Code 0 }}({{ .Code }}) \uf00d{{ else }}>{{ end }}",
          "type": "exit"
        }
      ],
      "type": "prompt"
    },
    {
      "segments": [
        {
          "background": "transparent",
          "foreground": "p:red",
          "properties": {
            "display_error": true,
            "display_mode": "files",
            "fetch_package_manager": false,
            "home_enabled": false
          },
          "style": "plain",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}\uf898 {{ .Full }} {{ end }}",
          "type": "node"
        },
        {
          "background": "transparent",
          "foreground": "p:yellow",
          "properties": {
            "display_error": true,
            "display_mode": "files",
            "fetch_version": true,
            "fetch_virtual_env": false
          },
          "style": "plain",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}\ue235 {{ .Full }} {{ end }}",
          "type": "python"
        },
        {
          "background": "transparent",
          "foreground": "p:white",
          "properties": {
            "display_error": true
          },
          "style": "plain",
          "template": "{{ if .Error }}{{ .Error }}{{ else }}{{ if .Name }}in {{ .Name }}{{ if .Version }}(<p:blue><b>{{.Version}}</b></>){{ end }}{{ end }} {{ end }}",
          "type": "project"
        },
        {
          "background": "transparent",
          "foreground": "p:white",
          "style": "plain",
          "template": "at <p:blue><b>{{ .CurrentDate | date \"15:04:05\" }}</b></>",
          "type": "time"
        }
      ],
      "type": "rprompt"
    }
  ],
  "console_title_template": "{{ .Folder }}",
  "final_space": true,
  "palette": {
    "black": "#2A2F3E",
    "blue": "#02bcce",
    "green": "#8FD15A",
    "grey": "#A8B0D9",
    "orange": "#E8AE5A",
    "red": "#FF6F92",
    "white": "#E0DEF4",
    "yellow": "#FEAC00"
  },
  "version": 3
}
