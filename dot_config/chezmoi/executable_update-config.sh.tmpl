#!/bin/bash
# Regenerate chezmoi.toml with auto-resolved SSH key info

set -euo pipefail

TEMPLATE_FILE="{{ .chezmoi.sourceDir }}/dot_config/chezmoi/.update-chezmoi-toml.tmpl"
CONFIG_FILE="$HOME/.config/chezmoi/chezmoi.toml"

echo "Regenerating $CONFIG_FILE..."
chezmoi execute-template < "$TEMPLATE_FILE" > "$CONFIG_FILE"
echo "Done!"
