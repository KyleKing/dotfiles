#!/bin/bash -e
#      ^----- get shellcheck hints based on bash
# https://github.com/koalaman/shellcheck/issues/809#issuecomment-631194320
#
# Dot File Syncing Scripts

op-sign-in() {
  op signin --account={{ .onepassword.domain }}
}

back-apply-ch() {
    # Apply any changes to local files
    op-sign-in || return 1
    chezmoi apply
}

back-pull-ch() {
    # Pull latest version and apply to local files
    op-sign-in || return 1
    cd "$(chezmoi source-path)" || return 1
    chezmoi update
    back-fresh-clear
}

back-scripts-ch() {
    # Run useful scripts to update generated files, such as listing plugins for Brew, uvx, etc.
    "$HOME/.config/my_config/generate_machine_snapshot.sh"
}

back-c-ch() {
    # Prevent overwriting chezmoi edits by checking for staged or unstaged changes
    cd "$(chezmoi source-path)" || return 1
    if output=$(git status --porcelain) && [ -z "$output" ]; then
        op-sign-in || return 1
        back-scripts-ch || return 1
        # Only re-add targets backed by a .tmpl source, so drift in a plain
        # (non-templated) file doesn't get silently absorbed here
        local drifted=() target src
        while IFS= read -r target; do
            [ -z "$target" ] && continue
            src="$(chezmoi source-path "$target" 2>/dev/null)"
            [[ "$src" == *.tmpl ]] && drifted+=("$target")
        done < <(chezmoi status --include=files --path-style=absolute | awk '{print $2}')
        if [ "${#drifted[@]}" -eq 0 ]; then
            echo "No templated files out of sync."
            return 0
        fi
        echo "Templated files out of sync:"
        printf '  %s\n' "${drifted[@]}"
        chezmoi re-add "${drifted[@]}"
        # Fold literal personal values that re-add just baked in back into templates
        "$HOME/.config/my_config/detemplate.py"
    else
        RED='\033[0;31m'
        NC='\033[0m'
        echo -e "${RED}Chezmoi git status must be clean before re-adding${NC}"
        return 1
    fi
}
# Review in LazyGit afterward: back-c-ch && lzg

# Obsidian Syncing Snippets
# DEPRECATED: vault is being archived. Excluded from the hourly freshness check
# in _repo_freshness.sh and from back-pull-all/back-stat-all below; run manually.
alias back-pull-obs="cd / && z {{ .obsidian.vault_name }} && git pull"
back-c-obs() {
    # FYI: `man strftime` provides the same information as Python docs and https://strftime.org/
    MSG="Manual vault backup - $(date -u "+%b %d, %Y %H:%M")"
    printf "Creating commit for: '%s'\n" "$MSG"
    cd / && z {{ .obsidian.vault_name }} && ga . && gcmsg "$MSG"
}
# Push afterward: back-c-obs && lzg

# Karabiner Actions Syncing
alias back-pull-karabiner="cd ~/Developer/{{ .github.username }}/karabiner-actions && git pull && npm run build"

# NVIM Syncing
alias back-pull-nvim="cd ~/.config/nvim && git pull && back-fresh-clear"
back-c-nvim() {
    MSG="chore: manual nvim backup - $(date -u "+%b %d, %Y %H:%M")"
    printf "Creating commit for: '%s'\n" "$MSG"
    cd ~/.config/nvim && ga . && gcmsg "$MSG"
}
# Push afterward: back-c-nvim && lzg

back-stat-nvim() {
    cd ~/.config/nvim || return 1
    echo "$PWD" && git status
}
alias back-stat-ch="cd / && z chezmoi && echo \$PWD && git status"

# Mani-managed directories (each holds its own mani.yaml)
_MANI_DIRS=(
    "$HOME/Developer/executablebooks"
    "$HOME/Developer/{{ .github.username }}"
)

back-pull-mani() {
    local dir
    for dir in "${_MANI_DIRS[@]}"; do
        echo "--- $dir ---"
        (cd "$dir" && mani sync && mani run git-pull --all --forks 8) || return 1
    done
}

back-stat-mani() {
    # Uses the git-ahead-behind task defined in each mani.yaml
    local dir
    for dir in "${_MANI_DIRS[@]}"; do
        echo "--- $dir ---"
        (cd "$dir" && mani run git-ahead-behind --all)
    done
}

# Composed from the single-repo commands above
alias back-pull-all="back-pull-nvim && back-pull-karabiner && back-pull-ch && back-pull-mani"
alias back-stat-all="back-stat-nvim && back-stat-ch && back-stat-mani"
