{{- if (eq .chezmoi.os "darwin") -}}
#!/bin/zsh -ex

# Could be modified to install from Brewfile, but prefer to capture machine state:
#	https://www.chezmoi.io/docs/how-to/#use-brew-bundle-to-manage-your-brews-and-casks

SCRIPT_DIR=$HOME/.config/my_config/scripts

# TODO: bad interpreter errors when running v5 locally
# Store code tags
# calcipy-tags tags.collect-code-tags --doc-sub-dir=.github --filename=Chezmoi_Code_Tags.md --base-dir=$HOME/.local/share/chezmoi || return 1

gh extension upgrade --all || return 1

# The Brewfile is the only brew state worth tracking. It already carries a
# description per entry and holds exactly what was installed by name, so a diff
# reads as "I added this tool" instead of drowning in version bumps. Query the
# rest live with ~/.config/my_config/brew_inventory.py (list, prune, compare).
# Note: no trailing '-}}' for below commands:
(brew bundle dump --file=- > "$SCRIPT_DIR/Brewfile.{{- .computer_name }}") || return 1
(brew doctor 2> "$SCRIPT_DIR/brew_doctor.{{- .computer_name }}") || true
(gh extension list > "$SCRIPT_DIR/gh_extensions.{{- .computer_name -}}.txt") || return 1
(uv tool list > "$SCRIPT_DIR/uv_list.{{- .computer_name -}}.txt") || return 1
(uvx pip config list --verbose > "$SCRIPT_DIR/pip_config.{{- .computer_name -}}.txt") || return 1
(mise list --current --json | jq 'map_values(.[0] | {version, requested_version, source: .source.path})' > "$SCRIPT_DIR/mise_list.{{- .computer_name -}}.json") || return 1
(mise plugins --all > "$SCRIPT_DIR/mise_plugins.{{- .computer_name -}}.txt") || return 1
chezmoi add "$SCRIPT_DIR" || return 1

cd ~/Developer/kyleking/karabiner-actions/
(git pull && npm run build) || return 1
cd ~

echo "Script Complete"
{{ end -}}
